# Copy this file to local.env for local debugging only.
# scripts/run-local.py injects these values into the HERALD child process environment.
# GitHub Actions does not read this file. Never commit local.env or real secrets.

# Non-sensitive values: copy these to GitHub Repository Variables after testing.
WATCH_IPS=原神,明日方舟
COUNTRY=CN
EXTRA_WEIBO_UIDS=
INCLUDE_IN_GAME=false
REMIND_DAY_BEFORE=true
PUBLISH_REACHABILITY=false
TIMEZONE=Asia/Shanghai

# Optional local-only table name from local-ai-providers.toml.
# When selected, the profile overrides the six AI_* values below, including AI_API_KEY.
AI_PROFILE=

# Direct configuration remains supported when AI_PROFILE is empty.
# Generic services: openai_compatible. Zhipu: zhipu_openai (zhipu-openai is also accepted).
AI_PROVIDER=openai_compatible
# Zhipu defaults to https://open.bigmodel.cn/api/paas/v4 when AI_BASE_URL is empty.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_VISION=false
AI_JSON_MODE=true

SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true

# Sensitive values: copy these to GitHub Repository Secrets after testing.
ORIGIN_CITY=
REACHABLE_CITIES=
NOTIFY_EMAIL=
AI_API_KEY=
# Only used when EXTRA_WEIBO_UIDS enables an optional Weibo source.
WEIBO_COOKIE=
SMTP_USERNAME=
SMTP_PASSWORD=
