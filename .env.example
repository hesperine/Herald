# Public local-development settings only. Do not commit real secrets.
WATCH_IPS=原神,明日方舟
COUNTRY=CN
REMIND_DAY_BEFORE=true
PUBLISH_REACHABILITY=false
TIMEZONE=Asia/Shanghai

# Use any user-owned OpenAI-compatible service.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_VISION=false
AI_JSON_MODE=true

SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true

# Put the following values in GitHub Repository Secrets in production:
# ORIGIN_CITY=
# REACHABLE_CITIES=
# NOTIFY_EMAIL=
# AI_API_KEY=
# WEIBO_COOKIE=
# SMTP_USERNAME=
# SMTP_PASSWORD=
